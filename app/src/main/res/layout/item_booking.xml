<?xml version="1.0" encoding="utf-8"?>
<!-- MỤC GIAO DIỆN: THẺ LỊCH ĐẶT SÂN (Dùng trong RecyclerView của Màn 5) -->
<!-- Thiết kế dạng thẻ CardView bo tròn, hiển thị đầy đủ: Sân, Ngày giờ, Giá và Trạng thái -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_booking_item"
    style="@style/SportMatchCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========================================== -->
        <!-- DÒNG 1: TÊN SÂN VÀ HUY HIỆU TRẠNG THÁI     -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_booking_item_venue_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/sportmatch_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Sân bóng đá Chảo Lửa" />

            <!-- Trạng thái: [Đã xác nhận] hoặc [Đã hoàn thành] -->
            <TextView
                android:id="@+id/tv_booking_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_status_confirmed"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="#1B5E20"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Đã xác nhận" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- DÒNG 2: SÂN CON VÀ MÔN THI ĐẤU             -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_court"
                app:tint="@color/sportmatch_primary" />

            <TextView
                android:id="@+id/tv_booking_item_court"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/sportmatch_text_secondary"
                android:textSize="13sp"
                tools:text="Sân số 1 (Bóng đá mini 5 người)" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- DÒNG 3: NGÀY VÀ KHUNG GIỜ THI ĐẤU          -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_clock"
                app:tint="@color/sportmatch_primary" />

            <TextView
                android:id="@+id/tv_booking_item_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/sportmatch_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="18:00 – 19:00 | Hôm nay, 18/10/2026" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- DÒNG 4: ĐỊA CHỈ SÂN                        -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location"
                app:tint="@color/sportmatch_text_tertiary" />

            <TextView
                android:id="@+id/tv_booking_item_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/sportmatch_text_secondary"
                android:textSize="13sp"
                tools:text="30 Phan Thúc Duyện, P.4, Tân Bình" />
        </LinearLayout>

        <!-- ĐƯỜNG KẺ NGĂN CÁCH THANH LỊCH -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/sportmatch_divider" />

        <!-- ========================================== -->
        <!-- DÒNG 5: MÃ ĐẶT SÂN, TỔNG TIỀN & XEM CHI TIẾT -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Mã đặt vé vắn tắt -->
            <TextView
                android:id="@+id/tv_booking_item_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sportmatch_text_tertiary"
                android:textSize="12sp"
                tools:text="Mã: SM-8899" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Tổng tiền -->
            <TextView
                android:id="@+id/tv_booking_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@color/sportmatch_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="180.000 đ" />

            <!-- Nút / nhãn bấm xem chi tiết -->
            <TextView
                android:id="@+id/tv_booking_item_view_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/booking_view_detail_action"
                android:textColor="@color/sportmatch_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
