<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/venue_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportmatch_background"
    android:orientation="vertical">

    <!-- Top Navigation Toolbar -->
    <LinearLayout
        android:id="@+id/venue_detail_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/sportmatch_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back_description"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/sportmatch_text_primary" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/venue_detail_title"
            android:textColor="@color/sportmatch_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Detail Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Hero Image Banner with Stadium Illustration -->
            <FrameLayout
                android:id="@+id/venue_detail_banner"
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <ImageView
                    android:id="@+id/iv_venue_banner_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_stadium_banner" />

                <!-- Gradient overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_banner_detail" />

                <!-- Badges on banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <!-- Sport Tag Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_sport"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp">

                        <TextView
                            android:id="@+id/venue_detail_sport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Bóng đá mini" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Rating badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_sport"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="⭐ 4.8 (120+ đánh giá)"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Venue Header Card (Name & Address) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SportMatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/venue_detail_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/sportmatch_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="Sân bóng Bình Thạnh" />

                    <TextView
                        android:id="@+id/venue_detail_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_location"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/sportmatch_text_secondary"
                        android:textSize="15sp"
                        tools:text="Bình Thạnh, TP.HCM" />

                    <TextView
                        android:id="@+id/venue_detail_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/sportmatch_text_secondary"
                        android:textSize="14sp"
                        tools:text="Cụm sân thể thao tiêu chuẩn, mặt sân êm, hệ thống chiếu sáng ban đêm hiện đại, thuận tiện cho sinh viên và người đi làm." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/sportmatch_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/sportmatch_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/venue_detail_hours_label"
                            android:textColor="@color/sportmatch_text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/venue_detail_hours"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/venue_detail_hours_val"
                            android:textColor="@color/sportmatch_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Amenities & Services Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SportMatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SportMatchSectionTitle"
                        android:text="@string/venue_detail_amenities_title" />

                    <!-- Amenities Flow / List -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_amenity_item"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="10dp"
                            android:text="@string/amenity_lighting"
                            android:textColor="@color/sportmatch_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_amenity_item"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="10dp"
                            android:text="@string/amenity_parking"
                            android:textColor="@color/sportmatch_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_amenity_item"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="10dp"
                            android:text="@string/amenity_canteen"
                            android:textColor="@color/sportmatch_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_amenity_item"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="10dp"
                            android:text="@string/amenity_wifi"
                            android:textColor="@color/sportmatch_text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_amenity_item"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="10dp"
                            android:text="@string/amenity_rental"
                            android:textColor="@color/sportmatch_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Courts List and Pricing Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SportMatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/SportMatchSectionTitle"
                        android:text="@string/venue_detail_courts_title" />

                    <!-- Dynamic container for Java to populate or show court options -->
                    <LinearLayout
                        android:id="@+id/sub_courts_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Venue Rules & Notes Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/SportMatchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/sportmatch_primary" />

                        <TextView
                            style="@style/SportMatchSectionTitle"
                            android:layout_marginStart="8dp"
                            android:text="@string/venue_detail_rules_title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/venue_detail_rules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="5dp"
                        android:text="@string/venue_detail_rules_content"
                        android:textColor="@color/sportmatch_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Sticky Bottom Call-to-Action Bar -->
    <LinearLayout
        android:id="@+id/venue_detail_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/venue_detail_price_prefix"
                android:textColor="@color/sportmatch_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_bottom_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/sportmatch_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="180.000đ/giờ" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_time_slot"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:backgroundTint="@color/sportmatch_primary"
            android:minWidth="170dp"
            android:text="@string/venue_detail_select_slot_btn"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
