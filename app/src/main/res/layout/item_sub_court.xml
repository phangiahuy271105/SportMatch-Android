<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/sportmatch_surface_variant"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/sportmatch_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Court Icon Container -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_amenity_item">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_court"
                app:tint="@color/sportmatch_primary" />
        </FrameLayout>

        <!-- Court details: name and status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_court_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sportmatch_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Sân số 1 (5 người)" />

            <TextView
                android:id="@+id/tv_court_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawableStart="@drawable/ic_check_circle"
                android:drawablePadding="4dp"
                android:text="@string/venue_detail_court_status_ready"
                android:textColor="@color/sportmatch_success"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Court price tag -->
        <TextView
            android:id="@+id/tv_court_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sportmatch_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="180.000đ/giờ" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
