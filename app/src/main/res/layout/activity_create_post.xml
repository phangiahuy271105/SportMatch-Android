<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:orientation="vertical">

    <!-- 1. THANH HEADER CÓ NÚT QUAY LẠI (BACK BUTTON) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#1C1E21" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Tạo bài đăng mới"
            android:textColor="#1C1E21"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. PHẦN FORM NHẬP THÔNG TIN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Môn thể thao -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Môn thể thao:"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtSport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="VD: Bóng đá mini, Cầu lông..."
                    android:inputType="textNoSuggestions|textCapSentences"
                    android:padding="10dp" />

                <!-- Địa điểm -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Địa điểm sân:"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="VD: Sân Bình Thạnh, Q. Bình Thạnh"
                    android:inputType="textNoSuggestions|textCapSentences"
                    android:padding="10dp" />

                <!-- Thời gian -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Thời gian đá / chơi:"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="VD: 19:00 - 21:00 (Hôm nay)"
                    android:inputType="textNoSuggestions|textCapSentences"
                    android:padding="10dp" />

                <!-- Số lượng tuyển -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Số lượng cần tuyển thêm:"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtMaxPlayers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="VD: 10"
                    android:inputType="number"
                    android:padding="10dp" />

                <!-- SỐ ĐIỆN THOẠI / ZALO LIÊN HỆ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="📞 Số điện thoại / Zalo liên hệ:"
                    android:textColor="#D32F2F"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@android:drawable/editbox_background"
                    android:hint="VD: 0987654321"
                    android:inputType="phone"
                    android:padding="10dp" />

                <!-- Ghi chú / Mô tả -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Mô tả / Ghi chú:"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:background="@android:drawable/editbox_background"
                    android:gravity="top"
                    android:hint="VD: Cần tìm 2 chân đá vui vẻ, trình độ trung bình..."
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:padding="10dp" />

                <!-- Nút Đăng bài -->
                <Button
                    android:id="@+id/btnSubmitPost"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#1877F2"
                    android:text="Đăng bài ngay"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>
</LinearLayout>