<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sportmatch_background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/venues_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/venue_list_title"
                    android:textColor="@color/sportmatch_text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/app_slogan"
                    android:textColor="@color/sportmatch_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/sport_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filter_all"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checkable="true"
                        android:checked="true"
                        android:text="@string/filter_all_sports" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filter_football"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checkable="true"
                        android:text="@string/sport_football" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/filter_badminton"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checkable="true"
                        android:text="@string/sport_badminton" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:labelFor="@id/district_filter"
                    android:text="@string/filter_district_label"
                    android:textColor="@color/sportmatch_text_secondary"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/district_filter"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="@string/filter_district_label"
                    android:entries="@array/district_filters" />

                <TextView
                    android:id="@+id/result_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/sportmatch_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="4 sân phù hợp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/empty_venues"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp"
                        android:text="@string/empty_venues"
                        android:textColor="@color/sportmatch_text_secondary"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/venue_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/matches_panel"
            style="@style/SportMatchEmptyPanel"
            android:visibility="gone">

            <TextView
                style="@style/SportMatchEmptyTitle"
                android:text="@string/nav_matches" />

            <TextView
                style="@style/SportMatchEmptyMessage"
                android:text="@string/matches_empty_message" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_panel"
            style="@style/SportMatchEmptyPanel"
            android:visibility="gone">

            <TextView
                style="@style/SportMatchEmptyTitle"
                android:text="@string/nav_profile" />

            <TextView
                style="@style/SportMatchEmptyMessage"
                android:text="@string/profile_empty_message" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sportmatch_surface"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_navigation" />
</LinearLayout>
